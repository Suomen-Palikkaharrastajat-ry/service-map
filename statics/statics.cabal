cabal-version: 2.2
name:          statics
version:       0.1.0.0
synopsis:      Static file generator for the Suomen Palikkaharrastajat service map
description:
  Fetches published locations from PocketBase and generates:
  RSS/Atom/JSON feeds and GeoJSON.
license:       BSD-2-Clause
build-type:    Simple

common lib-opts
  ghc-options: -Wall
  default-extensions: OverloadedStrings

common exe-opts
  ghc-options: -Wall -threaded -rtsopts -with-rtsopts=-N

library
  import:           lib-opts
  hs-source-dirs:   src
  exposed-modules:
    Config
    PocketBase
    DateUtils
    FeedGen
    GeoJsonGen
  build-depends:
    statics-common,
    base          >=4.7 && <5,
    text,
    bytestring,
    aeson,
    http-conduit,
    http-client,
    http-client-tls,
    time,
    blaze-html,
    blaze-markup,
    feed,
    async,
    directory,
    filepath,
    base64-bytestring,
    containers,
    JuicyPixels
  default-language: Haskell2010

executable statics
  import:           exe-opts
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    base      >=4.7 && <5,
    containers,
    directory,
    time,
    statics,
    statics-common
  default-language: Haskell2010

test-suite statics-test
  import:           lib-opts
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   tests
  build-depends:
    base            >=4.7 && <5,
    statics,
    tasty,
    tasty-hunit,
    tasty-quickcheck,
    aeson,
    bytestring,
    containers,
    time,
    text
  default-language: Haskell2010
